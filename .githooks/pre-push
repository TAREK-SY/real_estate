#!/bin/sh
# Runs the three quality gates before every push.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# The gates run on the working tree, so the hook refuses to push when there
# are uncommitted changes or when the pushed branch is not HEAD: otherwise
# it would check files other than the ones being pushed.

cd "$(git rev-parse --show-toplevel)" || exit 1

head_sha=$(git rev-parse HEAD)
zero_sha=0000000000000000000000000000000000000000
must_check=0

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.
while read -r local_ref local_sha _remote_ref _remote_sha; do
  case "$local_ref" in refs/heads/*) ;; *) continue ;; esac
  [ "$local_sha" = "$zero_sha" ] && continue

  if [ "$local_sha" != "$head_sha" ]; then
    echo "pre-push: ${local_ref#refs/heads/} is not the current HEAD."
    echo "          Switch to it first so the gates check the pushed commit."
    exit 1
  fi
  must_check=1
done

[ "$must_check" -eq 0 ] && exit 0

if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: uncommitted changes present; the gates would not test what is pushed."
  echo "          Commit or stash them, then push again."
  git status --short
  exit 1
fi

failed=""

# Every gate runs even if an earlier one fails, to show all problems at once.
echo "pre-push [1/3] dart format"
dart format --output=none --set-exit-if-changed . || failed="$failed format"

echo "pre-push [2/3] flutter analyze"
flutter analyze || failed="$failed analyze"

echo "pre-push [3/3] flutter test"
flutter test || failed="$failed test"

if [ -n "$failed" ]; then
  echo ""
  echo "pre-push: push rejected, failing gates:$failed"
  exit 1
fi

echo "pre-push: all three gates passed."
exit 0
